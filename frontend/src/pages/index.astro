---
import Layout from "../layouts/Layout.astro";
import NecklaceCard from "../components/NecklaceCard.astro";
import necklaces from "../data/necklaces.json";
import { withBase } from "../utils/base";

const base = import.meta.env.BASE_URL;
// Cloudflare R2 — main bucket public URL
import { R2_BASE } from "../utils/r2";
const CLOUDFLARE_FALLBACK = `${R2_BASE}/model_images/NKL-001-model.jpg`;
const ogImage = (necklaces as any[])[0]?.photos?.[0] ?? CLOUDFLARE_FALLBACK;
// Fixes: title/description updated to Handmade in Croatia
---

<!-- Fixes: Layout title/description → Handmade in Croatia -->
<Layout title="Tradicionalne, ručno rađene ogrlice. Handmade in Croatia." description="Tradicionalne, ručno rađene ogrlice. Handmade in Croatia." ogImage={ogImage}>
  <section class="hero">
    <div class="container">
      <h1>ručno rađene ogrlice<span style="color: var(--accent)">.</span></h1>
      <p>unikati izrađenih s ljubavlju — nježni perlični uzorci inspirirani prirodom</p>
    </div>
  </section>

  <section id="kolekcija" class="container">
    <div class="grid">
      {necklaces.map((n) => <NecklaceCard necklace={n as any} />)}
    </div>
  </section>


</Layout>
