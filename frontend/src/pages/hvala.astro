---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<!-- Fixes: Vinted profil link removed from thank-you page -->
<Layout title="Hvala na upitu!" description="Upit je poslan na kvizazist@gmail.com — javit ćemo se uskoro.">
  <section class="container thankyou">
    <div style="display:inline-flex; align-items:center; gap:8px; background:var(--card-bg); border:1px solid var(--border); padding:8px 14px; border-radius:999px; font-size:0.85rem; color:var(--muted)">✓ Poruka poslana</div>
    <h1>Hvala na upitu! ♡</h1>
    <p style="color:var(--muted); max-width:560px; margin:0 auto 22px">Vaša poruka je poslana. Javit ćemo se uskoro.</p>
    <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap">
      <a href={base} class="btn btn-primary">Natrag na kolekciju</a>
    </div>
  </section>
</Layout>
